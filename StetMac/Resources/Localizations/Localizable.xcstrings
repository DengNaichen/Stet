            "state": "translated",
            "value": "Utilizzato per ricevere l'input vocale"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声入力を受信するために使用されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 입력을 수신하는 데 사용됨"
          }
