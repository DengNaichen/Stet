    "Grant microphone and input control permissions so Stet can record and type text back into your apps.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grant microphone and input control permissions so Stet can record and type text back into your apps."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请授予麦克风与输入控制权限，以便 Stet 录制语音并将文字输入到你的应用中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "授予麥克風和輸入控制權限，以便 Stet 能夠錄音並將文字輸入您的應用。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewähren Sie Mikrofon- und Eingabesteuerungsberechtigungen, damit Stet Text aufzeichnen und in Ihre Apps eingeben kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otorga permisos de micrófono y control de entrada para que Stet pueda grabar y escribir texto en tus aplicaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accordez les autorisations de microphone et de contrôle de saisie pour que Stet puisse enregistrer et insérer du texte dans vos applications."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Concedi le autorizzazioni al microfono e al controllo dell'input affinché Stet possa registrare e inserire il testo nelle tue app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Stetが録音し、アプリにテキストを入力できるように、マイクと入力制御の権限を付与してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Stet이 녹음하고 앱에 텍스트를 입력할 수 있도록 마이크 및 입력 제어 권한을 부여하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conceda permissões de microfone e controle de entrada para que o Stet possa gravar e inserir texto em seus aplicativos."
          }
        }
      }
    },
