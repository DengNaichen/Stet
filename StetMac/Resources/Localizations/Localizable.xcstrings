    "Use a modifier-plus-key shortcut, for example Control + Space or Command + K. Two plain character keys will not register here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a modifier-plus-key shortcut, for example Control + Space or Command + K. Two plain character keys will not register here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用包含修饰键的组合（例如 Control + Space 或 Command + K），不支持仅使用两个普通字符键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請使用修飾鍵組合快捷鍵，例如 Control + Space 或 Command + K。無法在此處註冊兩個普通的字元鍵。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie einen Kurzbefehl mit Modifikatortaste, z. B. Control + Leertaste oder Befehl + K. Zwei einfache Zeichentasten werden hier nicht registriert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliza un atajo de tecla modificadora más tecla, por ejemplo, Control + Espacio o Command + K. Dos teclas de caracteres normales no se registrarán aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez un raccourci avec touche de modification, par exemple Contrôle + Espace ou Commande + K. Deux touches de caractères simples ne fonctionneront pas ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizza una scorciatoia con tasto modificatore, ad esempio Control + Spazio o Command + K. Due tasti con caratteri normali non verranno registrati qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "修飾キーとキーの組み合わせのショートカット（例: Control + Space または Command + K）を使用してください。2つの通常の文字キーは登録できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Control + Space 또는 Command + K와 같이 수정자-더하기-키 단축키를 사용하세요. 두 개의 일반 문자 키는 여기에 등록되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use um atalho de tecla modificadora com outra tecla, por exemplo, Control + Espaço ou Command + K. Duas teclas de caracteres normais não funcionarão aqui."
          }
        }
      }
    },
    "Use only what is needed": {
      "localizations": {
