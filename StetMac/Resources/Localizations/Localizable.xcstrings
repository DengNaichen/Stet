    "Stet stays in the menu bar for quick access even when the dock icon is hidden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stet stays in the menu bar for quick access even when the dock icon is hidden."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使隐藏程序坞图标，Stet 仍会常驻菜单栏方便随时调用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即使隱藏了 Dock 圖標，Stet 也會保留在菜單欄以便快速訪問。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stet bleibt in der Menüleiste für den schnellen Zugriff, auch wenn das Dock-Symbol ausgeblendet ist."
          }
        },
        "es": {
          "stringUnit": {
