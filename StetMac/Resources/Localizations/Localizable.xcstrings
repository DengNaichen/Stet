    "We've set Command + . as your default shortcut. Try pressing it now to see it in action.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We've set Command + . as your default shortcut. Try pressing it now to see it in action."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已为你设置默认快捷键 Command + .，现在按下即可试用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們已將 Command + . 設置為預設快捷鍵。現在試試看效果。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben Befehl + . als Standard-Kurzbefehl festgelegt. Drücken Sie ihn jetzt, um die Funktion zu testen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemos establecido Command + . como tu atajo predeterminado. Intenta presionarlo ahora para ver cómo funciona."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous avons défini Commande + . comme raccourci par défaut. Essayez d'appuyer dessus maintenant pour voir le résultat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbiamo impostato Command + . come scorciatoia predefinita. Prova a premerla ora per vederla in azione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトのショートカットとして Command + . を設定しました。今すぐ押して動作を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 단축키로 Command + .을 설정했습니다. 지금 눌러 작동하는지 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Configuramos Command + . como seu atalho padrão. Tente pressioná-lo agora para ver funcionando."
          }
        }
      }
    },
    "When pressed, do you see the button turn black?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When pressed, do you see the button turn black?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下时，按键是否显示为高亮状态？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按下後，您是否看到按鈕變黑？"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird die Schaltfläche beim Drücken schwarz?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al presionarlo, ¿ves que el botón se pone negro?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsqu'il est enfoncé, voyez-vous le bouton devenir noir ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando viene premuto, vedi che il pulsante diventa nero?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "押したときにボタンが黒くなるのが見えますか？"
