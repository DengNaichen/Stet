          "stringUnit": {
            "state": "translated",
            "value": "Pressione o atalho novamente para parar."
          }
        }
      }
    },
    "Press the shortcut and speak naturally. We'll preserve your intent while performing necessary cleanup.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press the shortcut and speak naturally. We'll preserve your intent while performing necessary cleanup."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下快捷键并自然说话，Stet 会在保留原意的同时智能整理文字。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按下快捷鍵自然說話。我們會保留您的意圖並進行必要的整理。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücken Sie den Kurzbefehl und sprechen Sie natürlich. Wir bewahren Ihre Absicht bei und führen die notwendige Bereinigung durch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa el atajo y habla con naturalidad. Conservaremos tu intención mientras realizamos la limpieza necesaria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur le raccourci et parlez naturellement. Nous préserverons votre intention tout en effectuant les corrections nécessaires."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi la scorciatoia e parla in modo naturale. Conserveremo le tue intenzioni eseguendo la pulizia necessaria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットを押して自然に話してください。意図を保ちつつ必要な整理を行います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축키를 누르고 자연스럽게 말하세요. 필요한 정리를 수행하면서 당신의 의도를 보존합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione o atalho e fale naturalmente. Preservaremos sua intenção ao realizar a limpeza necessária."
          }
        }
      }
    },
