    "Browse themes on the right, then apply and finish.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browse themes on the right, then apply and finish."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在右侧浏览主题，随后应用并完成设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在右側瀏覽主題，然後應用並完成。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durchsuchen Sie die Designs auf der rechten Seite, wenden Sie sie an und schließen Sie ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Explora los temas a la derecha, luego aplícalo y termina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parcourez les thèmes à droite, puis appliquez et terminez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esplora i temi sulla destra, poi applica e termina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右側のテーマを閲覧し、適用して完了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽의 테마를 둘러본 다음 적용하고 완료하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Navegue pelos temas à direita, depois aplique e termine."
          }
        }
      }
    },
    "Browse themes on the right. The capsule shows a live preview.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browse themes on the right. The capsule shows a live preview."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在右侧浏览主题，悬浮胶囊会实时预览效果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在右側瀏覽主題。膠囊顯示即時預覽。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durchsuchen Sie die Designs auf der rechten Seite. Die Kapsel zeigt eine Live-Vorschau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Explora los temas a la derecha. La cápsula muestra una vista previa en vivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parcourez les thèmes à droite. La capsule affiche un aperçu en direct."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esplora i temi sulla destra. La capsula mostra un'anteprima dal vivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右側のテーマを閲覧してください。カプセルにライブプレビューが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽의 테마를 둘러보세요. 캡슐에서 실시간 미리보기를 볼 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Navegue pelos temas à direita. A cápsula mostra uma visualização ao vivo."
          }
        }
      }
    },
