          "stringUnit": {
            "state": "translated",
            "value": "Drücken Sie das Tastenkürzel erneut, um zu stoppen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a pulsar el atajo para detener."
          }
        },
