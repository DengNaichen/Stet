        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usado para receber entrada de voz"
          }
        }
      }
    },
    "Uses the on-device Apple Intelligence model to refine transcripts locally. Availability depends on Apple Intelligence being enabled and ready on this Mac.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses the on-device Apple Intelligence model to refine transcripts locally. Availability depends on Apple Intelligence being enabled and ready on this Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用设备端 Apple Intelligence 模型在本地优化转写结果；此功能需先在此 Mac 上启用并就绪 Apple Intelligence。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用設備端 Apple Intelligence 模型本地最佳化轉錄。可用性取決於此 Mac 上的 Apple Intelligence 是否已啟用並就緒。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet das lokale Apple Intelligence-Modell, um Transkripte auf dem Gerät zu optimieren. Die Verfügbarkeit hängt davon ab, ob Apple Intelligence auf diesem Mac aktiviert und bereit ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliza el modelo de Apple Intelligence en el dispositivo para refinar transcripciones localmente. Su disponibilidad depende de que Apple Intelligence esté habilitado y listo en este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise le modèle Apple Intelligence sur l'appareil pour améliorer les transcriptions localement. La disponibilité dépend de l'activation et de la préparation d'Apple Intelligence sur ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizza il modello Apple Intelligence sul dispositivo per rifinire le trascrizioni localmente. La disponibilità dipende dall'attivazione di Apple Intelligence su questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイス上のApple Intelligenceモデルを使用してローカルで文字起こしを改善します。このMacでApple Intelligenceが有効になり、準備ができているかどうかに依存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "온디바이스 Apple Intelligence 모델을 사용하여 로컬에서 전사 텍스트를 개선합니다. 사용 가능 여부는 이 Mac에서 Apple Intelligence가 켜져 있고 준비되었는지에 따라 다릅니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa o modelo do Apple Intelligence no dispositivo para refinar transcrições localmente. A disponibilidade depende de o Apple Intelligence estar ativado e pronto neste Mac."
          }
        }
      }
    },
