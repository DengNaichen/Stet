    "Onboarding reset. The onboarding window should appear again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Onboarding reset. The onboarding window should appear again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已重置引导流程，引导窗口将重新出现。"
          }
        }
      }
    },
    "Once you add words here, Stet will reuse them in transcription and rewrite.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once you add words here, Stet will reuse them in transcription and rewrite."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加到此处的词条将自动用于后续语音转写和文本优化。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "添加詞條後，Stet 將在轉錄和改寫時使用它們。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobald Sie hier Wörter hinzufügen, verwendet Stet diese bei der Transkription und Umschreibung wieder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vez que añadas palabras aquí, Stet las reutilizará en la transcripción y reescritura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois les mots ajoutés ici, Stet les réutilisera lors de la transcription et de la réécriture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo aver aggiunto delle parole qui, Stet le riutilizzerà nella trascrizione e riscrittura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここに単語を追加すると、Stetは文字起こしや書き換えの際にそれらを再利用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에 단어를 추가하면, Stet은 전사 및 다시 쓰기에서 이를 재사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao adicionar palavras aqui, o Stet as reutilizará na transcrição e reescrita."
          }
        }
      }
    },
    "One click gets you ready.": {
