    "Only enroll a speaker after you have permission. Stet deletes each recording immediately after creating an aggregate voice profile stored only on this Mac.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only enroll a speaker after you have permission. Stet deletes each recording immediately after creating an aggregate voice profile stored only on this Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在获得授权后再录入说话人。生成仅保存在本机的汇总声纹后，Stet 会立即删除原始录音。"
          }
        }
      }
    },
    "Only one owner profile can be enrolled.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only one owner profile can be enrolled."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只能录入一个本人声纹。"
          }
        }
      }
    },
    "Only selected calendars are synced into Stet meetings and Calendar MCP tools.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only selected calendars are synced into Stet meetings and Calendar MCP tools."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅同步已选日历至 Stet 会议与 Calendar MCP 工具。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有所選日曆會同步到 Stet 會議和 Calendar MCP 工具。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur ausgewählte Kalender werden mit Stet-Besprechungen und Calendar-MCP-Tools synchronisiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo los calendarios seleccionados se sincronizan con las reuniones de Stet y las herramientas MCP de Calendar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les calendriers sélectionnés sont synchronisés avec les réunions Stet et les outils MCP Calendar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo i calendari selezionati vengono sincronizzati con le riunioni Stet e gli strumenti MCP Calendar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したカレンダーのみが Stet の会議と Calendar MCP ツールに同期されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 캘린더만 Stet 회의와 Calendar MCP 도구에 동기화됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente os calendários selecionados são sincronizados com as reuniões do Stet e as ferramentas MCP Calendar."
