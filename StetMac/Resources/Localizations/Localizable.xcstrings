    "You can also launch with `--force-onboarding` or `STET_FORCE_ONBOARDING=1`.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can also launch with `--force-onboarding` or `STET_FORCE_ONBOARDING=1`."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你也可以通过命令行参数 `--force-onboarding` 或环境变量 `STET_FORCE_ONBOARDING=1` 启动以重新进入引导。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您也可以使用 `--force-onboarding` 或 `STET_FORCE_ONBOARDING=1` 啟動。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können auch mit `--force-onboarding` oder `STET_FORCE_ONBOARDING=1` starten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También puedes iniciar con `--force-onboarding` o `STET_FORCE_ONBOARDING=1`."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez également lancer avec `--force-onboarding` ou `STET_FORCE_ONBOARDING=1`."
          }
        },
        "it": {
