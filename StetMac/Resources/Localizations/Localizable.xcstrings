    },
    "Stet can play a sound and show a notification after your words are inserted.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stet can play a sound and show a notification after your words are inserted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "插入文字后，Stet 可播放提示音并发送系统通知。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文字插入後，Stet 可以播放提示音並顯示通知。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stet kann nach dem Einfügen deiner Wörter einen Ton abspielen und eine Mitteilung zeigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Stet puede reproducir un sonido y mostrar una notificación cuando se inserten tus palabras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stet peut jouer un son et afficher une notification une fois vos mots insérés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stet può riprodurre un suono e mostrare una notifica dopo l'inserimento delle parole."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字の挿入後、Stetはサウンドを再生し、通知を表示できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트가 삽입된 후 Stet이 소리를 재생하고 알림을 표시할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Stet pode reproduzir um som e mostrar uma notificação depois que suas palavras forem inseridas."
          }
        }
      }
    },
    "Stet can refine and improve the precision of your transcriptions using AI.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stet can refine and improve the precision of your transcriptions using AI."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Stet 可使用 AI 润色并提升转写文本的准确度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Stet 可以使用 AI 最佳化並提高轉錄精度。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stet kann Ihre Transkriptionen mithilfe von KI verfeinern und deren Präzision verbessern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Stet puede refinar y mejorar la precisión de tus transcripciones utilizando IA."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stet peut affiner et améliorer la précision de vos transcriptions grâce à l'IA."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stet può rifinire e migliorare la precisione delle tue trascrizioni utilizzando l'IA."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Stetは、AIを使用して文字起こしの精度を最適化し、向上させることができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Stet은 AI를 사용하여 전사 정확도를 조정하고 향상시킬 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Stet pode refinar e melhorar a precisão das suas transcrições usando IA."
          }
        }
      }
    },
    "Stet can't start this action because microphone and input control permissions are required.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stet can't start this action because microphone and input control permissions are required."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Stet 需要麦克风和输入控制权限才能执行此操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Stet 無法執行此操作，需要麥克風和輸入控制權限。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stet kann diese Aktion nicht starten, da Mikrofon- und Eingabesteuerungsberechtigungen erforderlich sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Stet no puede iniciar esta acción porque se requieren permisos de micrófono y control de entrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stet ne peut pas démarrer cette action car les autorisations d'accès au microphone et au contrôle de saisie sont requises."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stet non può avviare questa azione perché sono richieste le autorizzazioni per il microfono e il controllo dell'input."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクと入力制御の権限が必要なため、Stetはこのアクションを開始できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크 및 입력 제어 권한이 필요하기 때문에 Stet이 이 작업을 시작할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Stet não pode iniciar esta ação porque permissões de microfone e controle de entrada são necessárias."
          }
        }
      }
    },
    "Stet could not import that file.": {
