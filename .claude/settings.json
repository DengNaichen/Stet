{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PROJECT_DIR}/scripts/run-agent-hook\" python3 \"${CLAUDE_PROJECT_DIR}/.codex/hooks/arch.py\"",
            "timeout": 120
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"$(git rev-parse --show-toplevel)/scripts/run-agent-hook\" \"$(git rev-parse --show-toplevel)/scripts/setup-worktree\" --if-needed",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
