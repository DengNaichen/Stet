#!/bin/sh

set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

staged_swift_files=$(git diff --cached --name-only --diff-filter=ACMR | rg '\.swift$' || true)

if [ -z "$staged_swift_files" ]; then
    exit 0
fi

echo "pre-commit: formatting Swift sources"
make format

echo "pre-commit: re-staging formatted Swift files"
printf '%s\n' "$staged_swift_files" | xargs git add --

echo "pre-commit: running SwiftLint"
make swiftlint
