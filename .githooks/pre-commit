#!/bin/sh
set -eu

# Use Git's NUL-delimited output: paths may contain spaces or newlines.
# A missing tool or a failed Git command must fail the hook, not skip checks.
exec python3 - <<'PY'
import os
import subprocess
import sys

try:
    root = subprocess.check_output(["git", "rev-parse", "--show-toplevel"]).rstrip(b"\n")
    os.chdir(os.fsdecode(root))
    staged = subprocess.check_output(
        ["git", "diff", "--cached", "--name-only", "--diff-filter=ACMR", "-z"]
    )
    swift_files = [os.fsdecode(path) for path in staged.split(b"\0") if path.endswith(b".swift")]
    if swift_files:
        print("pre-commit: formatting Swift sources", flush=True)
        subprocess.run(["make", "format"], check=True)
        print("pre-commit: re-staging formatted Swift files", flush=True)
        subprocess.run(["git", "add", "--", *swift_files], check=True)
        print("pre-commit: running SwiftLint", flush=True)
        subprocess.run(["make", "swiftlint"], check=True)
except subprocess.CalledProcessError as error:
    sys.exit(error.returncode if error.returncode > 0 else 1)
except OSError as error:
    print(f"pre-commit: {error}", file=sys.stderr)
    sys.exit(1)
PY
