APPLE_TEAM_ID=67BL3M4FPS
DEVELOPER_ID_APPLICATION=Developer ID Application
NOTARY_PROFILE=stet-notary
GITHUB_REPOSITORY=your-org-or-user/stet
GITHUB_TAG=v1.0.0
RELEASE_TITLE=v1.0.0

# Optional: generate, file, tag, none
# GITHUB_RELEASE_NOTES_MODE=generate

# Optional: markdown file for GitHub release notes when mode is `file`,
# or prepend notes when mode is `generate`
# RELEASE_NOTES_PATH=/absolute/path/to/release-notes.md

# Optional release flags
# GITHUB_RELEASE_LATEST=true
# GITHUB_RELEASE_PRERELEASE=false
# GITHUB_RELEASE_DRAFT=false
# GITHUB_RELEASE_VERIFY_TAG=true
# GITHUB_RELEASE_TARGET=<commit-sha-or-branch>

# Optional: override the default GitHub Releases download prefix
# SPARKLE_FEED_BASE_URL=https://github.com/your-org-or-user/stet/releases/download/v1.0.0

# Required if you want Sparkle enabled in the shipped app
# SPARKLE_APPCAST_URL=https://downloads.example.com/stet/appcast.xml
# SPARKLE_PUBLIC_ED_KEY=your-public-ed25519-key

# Optional: path to your Sparkle private Ed25519 key file
# SPARKLE_PRIVATE_KEY_PATH=/absolute/path/to/sparkle-private-key

# Optional: use a keychain account instead of a key file
# SPARKLE_KEYCHAIN_ACCOUNT=ed25519

# Optional: set to 0 if you only want a notarized DMG for GitHub Releases
# GENERATE_SPARKLE_APPCAST=1
