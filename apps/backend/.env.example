# Required for OpenAI provider (default)
OPENAI_API_KEY=

# Required for Groq provider
# GROQ_API_KEY=

# Managed billing mode: "managed" (default) or "unmetered"
# RELAY_BILLING_BACKEND=managed

# Beta invite defaults
# RELAY_BETA_TRIAL_CREDITS=3000
# RELAY_DAILY_CREDIT_LIMIT=1500
# RELAY_MAX_REQUESTS_PER_MINUTE=6
# RELAY_MAX_CONCURRENT_REQUESTS=2

# Upload sanity limits
# RELAY_MAX_AUDIO_BYTES=33554432
# RELAY_MAX_AUDIO_DURATION_SECONDS=900
# RELAY_MIN_BYTES_PER_SECOND=256
# RELAY_MAX_BYTES_PER_SECOND=131072

# Stripe remains disabled by default for beta.
# Set to true only when you are ready to accept webhook-driven top-ups.
# RELAY_ENABLE_STRIPE_WEBHOOK=false
