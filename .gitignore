# =============================================================================
# Stet monorepo — canonical ignore rules (repository root only)
# =============================================================================

# macOS / Xcode
.DS_Store
Thumbs.db
DerivedData/
.derivedData/
build/
.build/
.deps/
dist/
VoiceInk/
# Allow tracking local source packages while keeping .build/ ignored globally.
# Packages/
*.swiftpm/
*.xcuserstate
xcuserdata/
**/*.xcodeproj/project.xcworkspace/
*.xcodeproj/project.xcworkspace/
*.xcodeproj/project.xcworkspace/xcuserdata/
*.xcworkspace/xcuserdata/
*.profraw
*.tmp
*.swp

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# C / C++
*.o
*.a
*.so
*.dylib
*.dll
*.exe

# Local environment and secrets
.env
.env.release
.env.local
.env.*.local
.env.keys
sparkle-private-key

# Editor / agent local tooling
.claude/settings.json
.vscode/
.idea/
/HANDOFF.md

# Node / web
node_modules/
.next/
.svelte-kit/
.turbo/
.vercel/
coverage/
out/
*.tsbuildinfo
*.log
.wrangler/

# Supabase local state
supabase/.branches/
supabase/...temp/
.supabase/
*.p8

# Vendor binaries and downloaded runtimes
**/*.xcframework/
sherpa-onnx/
.runtime/
**/.runtime/
/Private/StetMobile/.runtime

# iOS model payloads (never commit ONNX weights)
/Private/StetMobile/**/*.onnx

# Legacy layout paths (pre-unified monorepo)
/StetMobile/

# Harness archive (local-only legacy specs)
/docs/archive/specs-legacy/
