{
  "description": "Repository-local architecture check on changed StetMac sources at turn end (read-only); on new violations, feeds back the errors plus the rules.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"$(git rev-parse --show-toplevel)/scripts/run-agent-hook\" python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/arch.py\"",
            "timeout": 120,
            "statusMessage": "Checking architecture rules (read-only)"
          }
        ]
      }
    ]
  }
}
